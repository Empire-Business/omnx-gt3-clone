# Nome do app (aparece no título, header, emails, etc.)
VITE_APP_NAME=OMNX GT3

# Supabase — pegue em: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# URL pública do app (usada em redirects de auth)
# Local: http://localhost:5173
# Produção: https://app.seu-dominio.com
VITE_SITE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Secrets de Edge Functions — NÃO vão no .env do frontend.
# Configure em: Supabase → Edge Functions → Secrets
# (ou via `supabase secrets set NOME=valor`)
#
# • RESEND_API_KEY → chave da API Resend (re_...). Usada pela função
#   email-unread-chat para enviar a notificação de mensagens não lidas.
# • EMAIL_FROM → remetente verificado no Resend, ex: "GT3 <nao-responda@omnx.pro>"
# • CRON_SECRET → segredo compartilhado com o pg_cron (header x-cron-secret).
# • VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT → Web Push (send-chat-notification).
# -----------------------------------------------------------------------------
# IMPORTANTE — o que NÃO vai aqui:
#
# • SUPABASE_SERVICE_ROLE_KEY → fica no painel do Supabase em
#   Edge Functions → Secrets. NUNCA coloque no .env (bypassa RLS).
#
# • SUPABASE_ACCESS_TOKEN → gerado pelo `supabase login` e salvo
#   automaticamente pela CLI. Não precisa estar aqui.
# -----------------------------------------------------------------------------
