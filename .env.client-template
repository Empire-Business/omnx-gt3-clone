# =============================================================================
# EMPIRE MANAGER — Template de Variáveis de Ambiente (Clientes)
# =============================================================================
# Preencha os valores abaixo e configure no painel do Lovable/Vercel.
# NUNCA commit este arquivo com valores reais.
#
# INSTRUÇÃO: Quando duplicar este projeto para outra pessoa/empresa,
# TODAS as chaves abaixo devem ser trocadas — inclusive as de serviços externos.
# NUNCA reutilize as chaves do projeto original.
# =============================================================================

# =============================================================================
# SUPABASE — Obrigatório (mudam ao criar novo projeto)
# =============================================================================
# Encontre em: Dashboard Supabase → Project Settings → API
VITE_SUPABASE_URL=https://<SEU-PROJECT-REF>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# =============================================================================
# SUPABASE — Edge Functions Secrets (configurar no Dashboard)
# =============================================================================
# Project Settings → Edge Functions → Secrets
SUPABASE_URL=https://<SEU-PROJECT-REF>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# =============================================================================
# APLICAÇÃO
# =============================================================================
# URL pública do app (usada em redirecionamentos de auth e emails)
VITE_SITE_URL=https://<seu-dominio>.vercel.app
SITE_URL=https://<seu-dominio>.vercel.app

# =============================================================================
# SUPABASE CLI (apenas para desenvolvimento local / deploy de edge functions)
# =============================================================================
SUPABASE_ACCESS_TOKEN=<supabase-personal-access-token>

# =============================================================================
# SERVIÇOS EXTERNOS — Criar contas próprias (NÃO reutilizar do projeto original)
# =============================================================================

# --- LiveKit (reuniões por vídeo) ---
# Crie conta em: https://livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- OpenRouter (IA / processamento de transcrições) ---
# Crie conta em: https://openrouter.ai
OPENROUTER_API_KEY=

# --- Resend (envio de emails) ---
# Crie conta em: https://resend.com
RESEND_API_KEY=

# --- Web Push (notificações no navegador) ---
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu@email.com

# --- Soniox (transcrição de áudio em tempo real) ---
# Crie conta em: https://soniox.com
SONIOX_API_KEY=

# --- S3 / R2 (armazenamento de gravações de reunião) ---
# Crie bucket em Cloudflare R2, AWS S3 ou MinIO
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
